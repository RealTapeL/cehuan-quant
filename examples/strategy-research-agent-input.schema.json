{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cehuan-quant.local/schemas/strategy-research-agent-input-v1.json",
  "title": "Cehuan strategy research agent input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "research_id", "objective", "scope", "data_trust", "frozen_strategy", "prior_experiments", "known_data_gaps", "allowed_actions", "forbidden_actions"],
  "properties": {
    "schema_version": {"const": 1},
    "research_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "required": ["market", "start_date", "end_date", "universe_id"], "properties": {"market": {"const": "CN_A_SHARE"}, "start_date": {"type": "string", "format": "date"}, "end_date": {"type": "string", "format": "date"}, "universe_id": {"type": "string"}}, "additionalProperties": false},
    "data_trust": {
      "type": "object",
      "required": ["input_file_integrity", "canonical_data_quality", "checkpoint_binding", "historical_availability_and_vendor_vintage", "market_rule_coverage", "fee_coverage", "corporate_action_coverage", "formal_baseline", "overall"],
      "properties": {
        "input_file_integrity": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}, "sha256": {"type": ["string", "null"]}, "scope": {"type": "string"}}, "additionalProperties": true},
        "canonical_data_quality": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}, "scope": {"type": "string"}}, "additionalProperties": true},
        "checkpoint_binding": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}, "scope": {"type": "string"}}, "additionalProperties": true},
        "historical_availability_and_vendor_vintage": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}, "scope": {"type": "string"}}, "additionalProperties": true},
        "market_rule_coverage": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}, "fallback_rows": {"type": "integer", "minimum": 0}, "mode": {"type": "string"}}, "additionalProperties": true},
        "fee_coverage": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}, "mode": {"type": "string"}, "personal_brokerage_rate": {"type": "string"}}, "additionalProperties": true},
        "corporate_action_coverage": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}, "typed_events_consumed": {"type": "integer", "minimum": 0}, "scope": {"type": "string"}}, "additionalProperties": true},
        "formal_baseline": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}, "interpretation": {"type": "string"}}, "additionalProperties": true},
        "overall": {"type": "string"}
      },
      "additionalProperties": true
    },
    "frozen_strategy": {"type": "object", "required": ["strategy_id", "config_sha256", "parameters"], "properties": {"strategy_id": {"type": "string"}, "config_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "parameters": {"type": "object"}}, "additionalProperties": false},
    "prior_experiments": {"type": "array", "items": {"type": "object", "required": ["experiment_id", "result_type", "summary", "input_digest"], "properties": {"experiment_id": {"type": "string"}, "result_type": {"type": "string"}, "summary": {"type": "string"}, "input_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}, "additionalProperties": false}},
    "review_summary": {"type": ["object", "null"]},
    "market_research_summary": {
      "type": "object",
      "required": ["schema", "summary_id", "summary_sha256", "classification", "facts", "evidence_catalog"],
      "properties": {
        "schema": {"const": "cehuan.real_market_research_summary_input.v1"},
        "summary_id": {"type": "string", "minLength": 1},
        "summary_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "classification": {"const": "REAL_MARKET_DATA_RESEARCH_SUMMARY_NOT_FORMAL_BACKTEST"},
        "facts": {"type": "object"},
        "evidence_catalog": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["fact_id", "statement", "artifact_sha256", "evidence_status"],
            "properties": {
              "fact_id": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "evidence_status": {"enum": ["RECORDED", "RECONSTRUCTED", "UNVERIFIED"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "experiment_capabilities": {
      "type": "object",
      "required": ["source", "maximum_changes_per_experiment", "supported_parameters"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "maximum_changes_per_experiment": {"type": "integer", "minimum": 1},
        "supported_parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["config_path", "value_type", "minimum_inclusive", "maximum_inclusive", "current_value"],
            "properties": {
              "config_path": {"type": "string", "minLength": 1},
              "value_type": {"enum": ["integer", "number"]},
              "minimum_inclusive": {"type": "number"},
              "maximum_inclusive": {"type": "number"},
              "current_value": {"type": "number"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "known_data_gaps": {"type": "array", "items": {"type": "string"}},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PROPOSE_HYPOTHESIS", "EXPLAIN_EVIDENCE", "DESIGN_VALIDATION"]}},
    "forbidden_actions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["MODIFY_ACTIVE_STRATEGY", "EXECUTE_BACKTEST_WITHOUT_APPROVAL", "GENERATE_BROKER_ORDER", "CONNECT_BROKER_ACCOUNT"]},
      "allOf": [
        {"contains": {"const": "MODIFY_ACTIVE_STRATEGY"}},
        {"contains": {"const": "EXECUTE_BACKTEST_WITHOUT_APPROVAL"}},
        {"contains": {"const": "GENERATE_BROKER_ORDER"}},
        {"contains": {"const": "CONNECT_BROKER_ACCOUNT"}}
      ]
    }
  }
}
